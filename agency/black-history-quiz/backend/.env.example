# Server Configuration
PORT=3000

# AI Provider Selection
# Choose: 'azure' (recommended for Microsoft), 'openai', or 'anthropic'
AI_PROVIDER=azure

# ===== AZURE OPENAI (RECOMMENDED FOR MICROSOFT HACKATHON) =====
# Get these from Azure Portal: https://portal.azure.com
# Go to: Azure OpenAI Service → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Benefits of Azure OpenAI:
# ✅ Uses your Azure credits
# ✅ Microsoft compliance-friendly
# ✅ Perfect for hackathon presentation
# ✅ Same models as OpenAI

# ===== REGULAR OPENAI (FALLBACK) =====
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ===== ANTHROPIC CLAUDE (ALTERNATIVE) =====
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Note: Configure Azure OpenAI for best experience!
# Fallbacks: Will try Azure → OpenAI → Anthropic in that order
